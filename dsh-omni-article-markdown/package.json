{
  "name": "dsh-omni-article-markdown",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin exposing the 墨探/mdcli article-to-Markdown converter as a native md_article tool.",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">0.2.0-0 <0.2.2 || >=0.2.2-0 <0.3.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "omni-article-markdown",
    "mdcli",
    "markdown",
    "article"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "check": "bash scripts/dev.sh check",
    "check:installed": "bash scripts/dev.sh check --with-installed",
    "dev:boot": "bash scripts/dev.sh boot",
    "dev:dump": "bash scripts/dev.sh dump",
    "clean": "bash scripts/dev.sh clean"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1"
  }
}
